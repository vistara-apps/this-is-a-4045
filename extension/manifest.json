{
  "manifest_version": 3,
  "name": "RedditScribe",
  "version": "1.0.0",
  "description": "Capture, organize, and leverage Reddit insights effortlessly.",
  "permissions": [
    "activeTab",
    "storage",
    "scripting",
    "identity"
  ],
  "host_permissions": [
    "https://*.reddit.com/*",
    "https://old.reddit.com/*",
    "https://www.reddit.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://*.reddit.com/*",
        "https://old.reddit.com/*",
        "https://www.reddit.com/*"
      ],
      "js": ["content-script.js"],
      "css": ["styles.css"],
      "run_at": "document_end"
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "RedditScribe",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "web_accessible_resources": [
    {
      "resources": ["reddit-highlighter.js", "snippet-capture.js"],
      "matches": ["https://*.reddit.com/*"]
    }
  ],
  "externally_connectable": {
    "matches": ["https://localhost:*", "https://redditscribe.com/*"]
  }
}
